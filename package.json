{
  "name": "task-app-mern",
  "version": "0.0.0",
  "type": "module",
  "description": "Task App (Mern Stack) Backend Focused",
  "exports": {},
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "redis": "sudo docker compose up redis",
    "serverredis" : "concurrently \"npm run redis\" \"npm run server\"",
    "client": "npm run dev --prefix frontend",
    "seed:admin": "node backend/seeder/seedAdmin.js",
    "unseed:admin": "node backend/seeder/unseedAdmin.js",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
